---
import Media from './Media.astro';
import { services } from '../data/services.js';
---

<section class="track theme-ink" data-pin-track aria-label="Our services">
  <div class="track__head shell">
    <div>
      <p class="u-eyebrow" data-reveal="up" data-reveal-delay="60" style="margin-top:.75rem">Our services</p>
      <h2 class="track__title" data-split data-reveal-delay="120">Eight services. One dispatch desk.</h2>
    </div>
    <div class="track__meta">
      <p class="u-body">Keep scrolling — the whole operation moves sideways.</p>
      <div class="track__progress" aria-hidden="true"><i data-pin-progress></i></div>
    </div>
  </div>

  <div class="track__viewport" data-pin-stage>
    <ol class="track__lane" data-pin-lane>
      {services.map((service) => (
        <li class="tcard">
          <a class="tcard__link" href={`/services/${service.slug}/`}>
            <div class="tcard__media">
              <Media name={service.media.hero} alt={service.title} ratio="5 / 4" reveal={null} />
            </div>
            <div class="tcard__body">
              <p class="tcard__eyebrow">{service.eyebrow}</p>
              <h3 class="tcard__title">{service.title}</h3>
              <p class="tcard__text">{service.summary}</p>
              <span class="tcard__cta">
                View service
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 13L13 3M13 3H5M13 3v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Exactly one viewport tall: while the section is pinned there is no way to
     scroll, so anything past the fold would simply never be seen. */
  .track {
    position: relative;
    /* Sits on the reel's footage; the reel carries the ground. */
    background: transparent;
    color: var(--fg);
    height: 100svh;
    display: grid;
    /* minmax(0,…) stops the very wide lane from inflating the grid column and
       dragging the centred header off-screen with it. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(1.25rem, 0.8rem + 1.6vw, 2.5rem);
    padding-block: clamp(1.75rem, 1rem + 2.6vw, 3.5rem);
    overflow: hidden;
  }

  .track__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .track__title {
    margin-top: 1.1rem;
    max-width: 14ch;
    font-size: var(--fs-h2);
  }
  .track__meta { max-width: 30ch; padding-bottom: 0.25rem; }

  .track__progress {
    margin-top: 0.85rem;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .track__progress i {
    display: block;
    height: 100%;
    background: var(--brand-500);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .track__viewport { width: 100%; min-width: 0; min-height: 0; }

  /* One grid for the whole lane: every card subgrids these two rows, so the
     copy blocks line up across cards and the media absorbs the difference. */
  .track__lane {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(268px, 25vw, 400px);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: clamp(1rem, 0.5rem + 1.4vw, 2rem);
    height: 100%;
    padding-inline: var(--gutter);
    will-change: transform;
  }

  .tcard {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    min-width: 0;
    min-height: 0;
  }

  .tcard__link {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    min-height: 0;
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    transition: border-color 420ms var(--ease-out), transform 620ms var(--ease-out);
  }
  .tcard__link:hover { border-color: var(--line-strong); transform: translateY(-6px); }

  /* The media takes whatever height the tallest copy block leaves over. */
  .tcard__media { overflow: hidden; min-height: 0; }
  .tcard__media :global(.media),
  .tcard__media :global(.media__frame) { height: 100%; aspect-ratio: auto; }
  .tcard__media :global(.media__frame) { border-radius: 0; border: 0; border-bottom: 1px solid var(--line); }
  .tcard__media :global(img) { transition: transform 1.1s var(--ease-out); }
  .tcard__link:hover .tcard__media :global(img) { transform: scale(1.06); }

  .tcard__body {
    padding: clamp(1.1rem, 0.9rem + 0.7vw, 1.75rem);
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  /* Without subgrid the rows cannot be shared, so hold the copy block to a
     common height instead. */
  @supports not (grid-template-rows: subgrid) {
    .track__lane { grid-template-rows: minmax(0, 1fr); }
    .tcard, .tcard__link { grid-row: auto; grid-template-rows: minmax(0, 1fr) 13.5rem; }
  }

  .tcard__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-400);
  }
  .tcard__title { font-size: var(--fs-h4); }
  .tcard__text { font-size: var(--fs-body-sm); color: var(--fg-muted); }

  .tcard__cta {
    padding-top: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg);
  }
  .tcard__cta svg { width: 12px; height: 12px; transition: transform 340ms var(--ease-out); }
  .tcard__link:hover .tcard__cta svg { transform: translate(2px, -2px); }

  /* Below the pin breakpoint the lane becomes a snap-scrolling row. */
  .track.is-static .track__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .track.is-static .track__viewport::-webkit-scrollbar { display: none; }
  .track.is-static .tcard { scroll-snap-align: start; width: min(78vw, 340px); }

  @media (max-width: 900px) {
    .track { height: auto; display: block; padding-block: var(--section-y); }
    .track__head { flex-direction: column; align-items: flex-start; margin-bottom: 2.5rem; }
    .track__lane { grid-auto-columns: min(78vw, 340px); grid-template-rows: auto auto; height: auto; }
    .track__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .track__viewport::-webkit-scrollbar { display: none; }
    .tcard { scroll-snap-align: start; width: min(78vw, 340px); }
  }
</style>
