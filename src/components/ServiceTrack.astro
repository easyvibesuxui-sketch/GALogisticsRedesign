---
import Media from './Media.astro';
import { services } from '../data/services.js';
---

<section class="track theme-ink" data-pin-track aria-label="Our services">
  <div class="track__head shell">
    <div>
      <span class="sec-head__index" data-reveal="fade">[02]</span>
      <p class="u-eyebrow" data-reveal="up" data-reveal-delay="60" style="margin-top:.75rem">Our services</p>
      <h2 class="track__title" data-split data-reveal-delay="120">Eight services. One dispatch desk.</h2>
    </div>
    <div class="track__meta">
      <p class="u-body">Drag or keep scrolling — the whole operation moves sideways.</p>
      <div class="track__progress" aria-hidden="true"><i data-pin-progress></i></div>
    </div>
  </div>

  <div class="track__viewport">
    <ol class="track__lane" data-pin-lane>
      {services.map((service) => (
        <li class="tcard">
          <a class="tcard__link" href={`/services/${service.slug}/`}>
            <span class="tcard__index">{service.index}</span>
            <div class="tcard__media">
              <Media name={service.media.hero} alt={service.title} ratio="5 / 4" reveal={null} />
            </div>
            <div class="tcard__body">
              <p class="tcard__eyebrow">{service.eyebrow}</p>
              <h3 class="tcard__title">{service.title}</h3>
              <p class="tcard__text">{service.summary}</p>
              <span class="tcard__cta">
                View service
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 13L13 3M13 3H5M13 3v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* The stage is exactly one viewport tall so nothing is cut off while the
     section is pinned. */
  .track {
    background: var(--ink-850);
    color: var(--fg);
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: center;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem);
    overflow: hidden;
  }

  .track__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .track__title {
    margin-top: 1.1rem;
    max-width: 14ch;
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3.5rem);
  }
  .track__meta { max-width: 30ch; padding-bottom: 0.5rem; }

  .track__progress {
    margin-top: 1.5rem;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .track__progress i {
    display: block;
    height: 100%;
    background: var(--brand-500);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .track__viewport { width: 100%; display: flex; align-items: stretch; }

  .track__lane {
    display: flex;
    gap: clamp(1rem, 0.5rem + 1.4vw, 2rem);
    padding-inline: var(--gutter);
    will-change: transform;
  }

  .tcard {
    flex: none;
    width: clamp(268px, 25vw, 400px);
    height: clamp(380px, 56svh, 560px);
  }

  .tcard__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    transition: border-color 420ms var(--ease-out), transform 620ms var(--ease-out);
  }
  .tcard__link:hover { border-color: var(--line-strong); transform: translateY(-6px); }

  .tcard__index {
    position: absolute;
    top: 1rem;
    left: 1.15rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(8, 9, 11, 0.55);
    backdrop-filter: blur(6px);
    padding: 0.35em 0.7em;
    border-radius: var(--radius-pill);
  }

  /* Media takes whatever height the copy leaves, so every card lines up. */
  .tcard__media { overflow: hidden; flex: 1; min-height: 0; }
  .tcard__media :global(.media),
  .tcard__media :global(.media__frame) { height: 100%; aspect-ratio: auto; }
  .tcard__media :global(.media__frame) { border-radius: 0; border: 0; border-bottom: 1px solid var(--line); }
  .tcard__media :global(img) { transition: transform 1.1s var(--ease-out); }
  .tcard__link:hover .tcard__media :global(img) { transform: scale(1.06); }

  .tcard__body {
    padding: clamp(1.1rem, 0.9rem + 0.7vw, 1.75rem);
    display: grid;
    gap: 0.55rem;
    flex: none;
    align-content: start;
  }

  .tcard__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-400);
  }
  .tcard__title { font-size: var(--fs-h4); }
  .tcard__text { font-size: var(--fs-body-sm); color: var(--fg-muted); }

  .tcard__cta {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg);
  }
  .tcard__cta svg { width: 12px; height: 12px; transition: transform 340ms var(--ease-out); }
  .tcard__link:hover .tcard__cta svg { transform: translate(2px, -2px); }

  /* Below the pin breakpoint the lane becomes a snap-scrolling row. */
  .track.is-static .track__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .track.is-static .track__viewport::-webkit-scrollbar { display: none; }
  .track.is-static .tcard { scroll-snap-align: start; width: min(78vw, 340px); }

  @media (max-width: 900px) {
    .track { min-height: 0; display: block; padding-block: var(--section-y); }
    .track__head { flex-direction: column; align-items: flex-start; margin-bottom: 2.5rem; }
    .tcard { height: auto; }
    .track__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .track__viewport::-webkit-scrollbar { display: none; }
    .tcard { scroll-snap-align: start; width: min(78vw, 340px); }
  }
</style>
