---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';

import { gallery } from '../data/pages.js';

/* Varying aspect ratios keep the grid from reading as a spreadsheet. */
const ratios = ['4 / 5', '1 / 1', '4 / 3', '3 / 4', '1 / 1', '4 / 5', '4 / 3', '1 / 1', '3 / 4'];
---

<Base title={gallery.title} description={gallery.description}>
  <PageHero
    eyebrow={gallery.hero.eyebrow}
    heading={gallery.hero.heading}
    lead={gallery.hero.lead}
    crumbs={[{ label: 'Gallery' }]}
  />

  <section class="gal theme-ink section" data-gallery data-parallax-scope>
    <div class="shell">
      <div class="gal__bar">
        <ul class="gal__filters" role="tablist" aria-label="Filter gallery">
          {gallery.filters.map((filter, i) => (
            <li role="presentation">
              <button
                type="button"
                class:list={['gal__filter', { 'is-on': i === 0 }]}
                data-filter={filter}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                {filter}
                <span class="gal__filter-count" data-count-for={filter}></span>
              </button>
            </li>
          ))}
        </ul>
        <p class="gal__hint">Click an image to open it.</p>
      </div>

      <ul class="gal__grid" data-gallery-grid>
        {gallery.items.map((item, i) => (
          <li class="gal__cell" data-tag={item.tag} data-index={i}>
            <button class="gal__open" type="button" data-open={i} aria-label={`Open ${item.caption}`}>
              <Media
                name={item.media}
                alt={item.caption}
                ratio={ratios[i % ratios.length]}
                parallax={i % 3 === 0}
                parallaxSpeed={0.06}
                revealDelay={(i % 3) * 90}
              />
              <span class="gal__meta">
                <span class="gal__tag">{item.tag}</span>
                <span class="gal__caption">{item.caption}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Lightbox -->
  <dialog class="lb" data-lightbox aria-label="Gallery image">
    <button class="lb__close" type="button" data-lb-close aria-label="Close">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
    <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Previous">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 2L4 8l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Next">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 2l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="lb__stage">
      {gallery.items.map((item, i) => (
        <figure class="lb__item" data-lb-item={i} hidden>
          <Media name={item.media} alt={item.caption} ratio="16 / 10" reveal={null} />
          <figcaption>{item.tag} — {item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </dialog>

  <CtaBand
    eyebrow="Get in touch"
    heading="Want to see the equipment in person?"
    body="Our yards are in Cliffwood, NJ and Indianapolis, IN."
    actions={[{ label: 'Contact Us', href: '/contact-us/', variant: 'solid' }]}
  />
</Base>

<style>
  .gal__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  .gal__filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .gal__filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.65em 1.15em;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition: color 260ms var(--ease-out), border-color 260ms var(--ease-out), background-color 260ms var(--ease-out);
  }
  .gal__filter:hover { color: var(--fg); border-color: var(--line-strong); }
  .gal__filter.is-on { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .gal__filter-count { font-family: var(--font-mono); font-size: 0.6875rem; opacity: 0.6; }

  .gal__hint { font-size: 0.8125rem; color: var(--fg-faint); }

  .gal__grid {
    columns: 3;
    column-gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }
  .gal__cell {
    break-inside: avoid;
    margin-bottom: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    transition: opacity 420ms var(--ease-out), transform 520ms var(--ease-mask);
  }
  .gal__cell.is-filtered {
    display: none;
  }

  .gal__open {
    display: block;
    width: 100%;
    position: relative;
    text-align: left;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .gal__open :global(img) { transition: transform 1.15s var(--ease-out); }
  .gal__open:hover :global(img) { transform: scale(1.05); }

  .gal__meta {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: grid;
    gap: 0.15rem;
    padding: 1.75rem 1.15rem 1.15rem;
    background: linear-gradient(180deg, transparent, rgba(8, 9, 11, 0.82));
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 380ms var(--ease-out), transform 480ms var(--ease-mask);
  }
  .gal__open:hover .gal__meta,
  .gal__open:focus-visible .gal__meta { opacity: 1; transform: none; }
  .gal__tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-400);
  }
  .gal__caption { font-size: 0.875rem; color: #fff; }

  /* --- lightbox ---------------------------------------------------------- */
  .lb {
    width: min(1200px, 92vw);
    max-width: none;
    max-height: 92vh;
    border: 0;
    padding: 0;
    background: transparent;
    color: #f2f3f4;
    overflow: visible;
  }
  .lb::backdrop { background: rgba(6, 7, 9, 0.9); backdrop-filter: blur(10px); }

  .lb__stage { position: relative; }
  .lb__item { margin: 0; display: grid; gap: 1rem; }
  .lb__item[hidden] { display: none; }
  .lb__item figcaption { font-size: 0.8125rem; color: rgba(242, 243, 244, 0.66); }

  .lb__close, .lb__nav {
    position: absolute;
    z-index: 3;
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    background: rgba(8, 9, 11, 0.6);
    backdrop-filter: blur(8px);
    color: #fff;
    transition: background-color 260ms var(--ease-out), transform 260ms var(--ease-out);
  }
  .lb__close:hover, .lb__nav:hover { background: var(--brand-500); border-color: var(--brand-500); }
  .lb__close { top: -22px; right: -12px; }
  .lb__nav { top: 50%; transform: translateY(-50%); }
  .lb__nav svg, .lb__close svg { width: 15px; height: 15px; }
  .lb__nav--prev { left: -22px; }
  .lb__nav--next { right: -22px; }

  @media (max-width: 900px) {
    .gal__grid { columns: 2; }
    .lb__nav--prev { left: 8px; }
    .lb__nav--next { right: 8px; }
    .lb__close { right: 8px; top: -52px; }
  }
  @media (max-width: 560px) { .gal__grid { columns: 1; } }
</style>

<script>
  /* --- filters ----------------------------------------------------------- */
  const scope = document.querySelector('[data-gallery]');

  if (scope) {
    const cells = [...scope.querySelectorAll('.gal__cell')];
    const buttons = [...scope.querySelectorAll('[data-filter]')];

    buttons.forEach((button) => {
      const value = button.dataset.filter;
      const count = value === 'All'
        ? cells.length
        : cells.filter((cell) => cell.dataset.tag === value).length;
      const slot = button.querySelector('[data-count-for]');
      if (slot) slot.textContent = String(count).padStart(2, '0');
    });

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.filter;
        buttons.forEach((other) => {
          const on = other === button;
          other.classList.toggle('is-on', on);
          other.setAttribute('aria-selected', String(on));
        });
        cells.forEach((cell) => {
          cell.classList.toggle('is-filtered', value !== 'All' && cell.dataset.tag !== value);
        });
        if (window.__lenis) window.__lenis.resize();
      });
    });

    /* --- lightbox -------------------------------------------------------- */
    const dialog = document.querySelector('[data-lightbox]');
    const items = [...document.querySelectorAll('[data-lb-item]')];
    let current = 0;

    const show = (index) => {
      current = (index + items.length) % items.length;
      items.forEach((item, i) => { item.hidden = i !== current; });
    };

    scope.querySelectorAll('[data-open]').forEach((button) => {
      button.addEventListener('click', () => {
        show(Number(button.dataset.open));
        dialog.showModal();
        if (window.__lenis) window.__lenis.stop();
      });
    });

    dialog?.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    dialog?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));

    dialog?.addEventListener('close', () => {
      if (window.__lenis) window.__lenis.start();
    });

    dialog?.addEventListener('click', (event) => {
      // Clicking the backdrop (outside the stage) closes.
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if (!dialog?.open) return;
      if (event.key === 'ArrowRight') show(current + 1);
      if (event.key === 'ArrowLeft') show(current - 1);
    });
  }
</script>
